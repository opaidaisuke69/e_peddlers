# ==============================================================================
# e-Peddlers Environment Configuration Example
# ==============================================================================

APP_NAME="e-Peddlers – La Carlota City"
APP_ENV=development
APP_URL=http://localhost:8000
FRONTEND_WEB_URL=http://localhost:5173
FRONTEND_MOBILE_URL=http://localhost:8081
TIMEZONE=Asia/Manila

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=e_peddlers
DB_USER=root
DB_PASS=

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE_SECONDS=86400

# PayMongo Integration (TEST MODE ONLY)
PAYMONGO_SECRET_KEY=YOUR_TEST_SECRET_KEY
PAYMONGO_PUBLIC_KEY=YOUR_TEST_PUBLIC_KEY
PAYMONGO_WEBHOOK_SECRET=YOUR_TEST_WEBHOOK_SECRET
PAYMONGO_BASE_URL=https://api.paymongo.com/v1

# PHPMailer / SMTP Configuration
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=465
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=YOUR_VERIFIED_SENDER_EMAIL
SMTP_FROM_NAME="e-Peddlers La Carlota City"
SMTP_ENABLED=0

# Socket.IO Realtime Service
SOCKET_IO_URL=http://localhost:3001
